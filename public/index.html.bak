<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>VoxSage - AI Call Summarizer</title>
  <style>
    body {
      font-family: -apple-system, sans-serif;
      max-width: 700px;
      margin: 40px auto;
      padding: 0 20px;
      background: #f7f7f8;
      color: #1a1a1a;
    }
    h1 {
      font-size: 24px;
    }
    textarea {
      width: 100%;
      height: 120px;
      padding: 10px;
      font-size: 14px;
      border-radius: 8px;
      border: 1px solid #ccc;
      box-sizing: border-box;
    }
    button {
      background: #2563eb;
      color: white;
      border: none;
      padding: 10px 20px;
      border-radius: 8px;
      font-size: 14px;
      cursor: pointer;
      margin-top: 10px;
    }
    button:disabled {
      background: #9ca3af;
      cursor: not-allowed;
    }
    .result {
      background: white;
      border-radius: 8px;
      padding: 16px;
      margin-top: 20px;
      border: 1px solid #e5e7eb;
    }
    .search-section {
      margin-top: 50px;
      border-top: 1px solid #e5e7eb;
      padding-top: 30px;
    }
    input[type="text"] {
      width: 70%;
      padding: 10px;
      font-size: 14px;
      border-radius: 8px;
      border: 1px solid #ccc;
      box-sizing: border-box;
    }
    .hidden {
      display: none;
    }
    .error {
      color: #dc2626;
    }
  </style>
</head>
<body>
  <h1>VoxSage</h1>
  <p>Paste a call/chat transcript below to get an AI-generated summary and action items.</p>

  <textarea id="transcriptInput" placeholder="Paste transcript here..."></textarea>
  <br>
  <button id="summarizeBtn">Summarize</button>

  <div id="summaryResult" class="result hidden"></div>
  <div id="summaryError" class="error hidden"></div>

  <div class="search-section">
    <h2>Search Past Summaries</h2>
    <p>Search by meaning, not just exact words.</p>
    <input type="text" id="searchInput" placeholder="e.g. billing issue double charge">
    <button id="searchBtn">Search</button>

    <div id="searchResults"></div>
    <div id="searchError" class="error hidden"></div>
  </div>

  <script src="app.js"></script>
</body>
</html>
